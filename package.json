{
  "name": "typescriptlings",
  "version": "0.1.0",
  "description": "Small exercises to get you used to reading and writing TypeScript code! (Port of Rustlings v6.5.0)",
  "type": "module",
  "bin": {
    "typescriptlings": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "exercise": "node scripts/check-exercise.mjs",
    "check:exercises": "node scripts/verify-exercises.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "shell-quote": "^1.8.2",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/shell-quote": "^1.7.4",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
